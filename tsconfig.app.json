{
  // @vue/tsconfig/tsconfig.dom.json обычно заданы: target, module, strict, jsx, moduleResolution, lib и др.
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*.d.ts", "src/**/*.ts", "src/**/*.vue"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "paths": {
      "@/*": ["./src/*"]
    },

    // Запретить неиспользуемые переменные
    "noUnusedLocals": true,
    // Запретить неиспользуемые аргументы функций/методов
    "noUnusedParameters": true,
    // Проверяет наличие break в кейсах оператора switch
    "noFallthroughCasesInSwitch": true
  }
}
